{{> menu active="dashboard"}}

<section class="section">
  <div class="columns is-multiline">
    {{#each stations}}
      <div class="column is-full">
        {{> station-summary station=this stationSummary=this.stationSummary}}
             <form action="/station/{{this._id}}/update" method="POST" class="box mt-4">
          <div class="field">
            <label class="label">Title</label>
            <div class="control">
              <input class="input" type="text" name="title" value="{{this.title}}" required>
            </div>
          </div>

          <div class="field">
            <label class="label">Latitude</label>
            <div class="control">
              <input class="input" type="number" step="any" name="latitude" value="{{this.latitude}}" required>
            </div>
          </div>

          <div class="field">
            <label class="label">Longitude</label>
            <div class="control">
              <input class="input" type="number" step="any" name="longitude" value="{{this.longitude}}" required>
            </div>
          </div>

          <div class="control">
            <button class="button is-success" type="submit">Update Station</button>
          </div>
        </form>

        <hr>
      </div>
    {{/each}}
  </div>

  {{> add-station}}
  <div id="map" style="height: 400px;"></div>
  
</section>
<script>
  document.addEventListener("DOMContentLoaded", function () {
   
    const map = L.map("map").setView([53.3498, -6.2603], 5);  

    
    L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
      maxZoom: 19,
      attribution: '&copy; <a href="https://openstreetmap.org">OpenStreetMap</a> contributors',
    }).addTo(map);

    const stations = [
      {{#each stations}}
        {
          "title": "{{this.title}}",
          "latitude": {{this.latitude}},
          "longitude": {{this.longitude}}
        }{{#unless @last}},{{/unless}}
      {{/each}}
    ];


    stations.forEach(function(station) {
      if (!isNaN(station.latitude) && !isNaN(station.longitude)) {
        L.marker([station.latitude, station.longitude])
          .addTo(map)
          .bindPopup(station.title);  
      }
    });
  });
</script>
