<form class="box" action="/station/{{station._id}}/updatereport/{{report._id}}" method="POST">

  <div class="field is-horizontal">
    <div class="field-body">
      <div class="field">
        <label><b>Code</b></label>
       <input class="input" type="text" placeholder="00" name="code" value="{{report.code}}">
      </div>
      <div class="field">
         <label><b>Temperature</b></label>
        <input class="input" type="text" placeholder="00.0C" name="temp" value="{{report.temp}}">
      </div>
      <div class="field">
        <label><b>Wind speed</label></b>
        <input class="input" type="text" placeholder="00.00kMh" name="windSpeed" value="{{report.windSpeed}}">
      </div>
      <div class="field">
        <label><b>Wind Direction</b></label>
        <div class="control">
          <div class="select">
            <select name="windDirection">
              <option value="N" {{#if (eq report.windDirection "N")}}selected{{/if}}>North(0–45)</option>
              <option value="NE" {{#if (eq report.windDirection "NE")}}selected{{/if}}>North-East(46–90)</option>
              <option value="E" {{#if (eq report.windDirection "E")}}selected{{/if}}>East(91–135)</option>
              <option value="SE" {{#if (eq report.windDirection "SE")}}selected{{/if}}>South-East(136–180)</option>
              <option value="S" {{#if (eq report.windDirection "S")}}selected{{/if}}>South(181–225)</option>
              <option value="SW" {{#if (eq report.windDirection "SW")}}selected{{/if}}>South-West(226–270)</option>
              <option value="W" {{#if (eq report.windDirection "W")}}selected{{/if}}>West(271–315)</option>
              <option value="NW" {{#if (eq report.windDirection "NW")}}selected{{/if}}>North-West(316–360)</option>
             
            </select>
          </div>
        </div>
      </div>
    
      <div class="field">
        <label><b>Pressure</b></label>
        <input class="input" type="text" placeholder="000hPa" name="pressure" value="{{report.pressure}}">
      </div>
    </div>
  </div>
  <button class="button is-primary">Update report</button>
</form>