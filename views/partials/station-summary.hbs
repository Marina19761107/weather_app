<div class="box has-background-dark has-text-white">
  <div class="columns is-vcentered is-multiline">

    <div class="column is-2">
      <h4 class="title is-5" style="color: white">{{station.title}}</h4>
      <p>Lat: {{station.latitude}}</p>
      <p>Long: {{station.longitude}}</p>
      <a
        href="/station/{{station._id}}"
        class="button is-small is-info mt-2"
      >View</a>
    </div>

    <div class="column is-2">
      <h4 class="title is-6">Weather</h4>
      {{#if station.summary.latestReport}}
        <img
          src="https://openweathermap.org/img/wn/{{stationSummary.weatherIcon}}@2x.png"
          alt="Icon"
        />
        <p>Code: {{station.summary.latestReport.code}}</p>
      {{else}}
        <p>No weather data</p>
      {{/if}}
    </div>

    <div class="column is-2">
      <h4 class="title is-6">Temp</h4>
      {{station.summary.latestReport}}
      <p>Temperature</p>
      <p>Current: {{station.summary.latestReport.temp}}°C</p>
      <p>Min: {{station.summary.minTemp}}°C</p>
      <p>Max: {{station.summary.maxTemp}}°C</p>
    </div>

    <div class="column is-3">
      <h4 class="title is-6">Wind</h4>
      {{#if station.summary.latestReport}}
        <p>Speed: {{station.summary.windSpeed}} km/h</p>
        <p>Dir: {{station.summary.windDirection}}</p>
      {{else}}
        <p>No wind data</p>
      {{/if}}
    </div>

    <div class="column is-2">
      <h4 class="title is-6">Pressure</h4>
      {{#if station.summary.latestReport}}
        <p>{{station.summary.pressure}} hPa</p>
      {{else}}
        <p>No pressure data</p>
      {{/if}}
    </div>

  </div>
</div>