<form action="/dashboard/addstation" method="POST">
  <div class="field">
    <h1 class="title is-4"><strong>Create new station</strong></h1>
  </div>

  <div class="field">
    <label class="label">Station Title</label>
    <input
      class="input"
      type="text"
      placeholder="Enter station title"
      name="title"
    />
  </div>
  <div class="field">
    <label class="label">Latitude</label>
    <input
      class="input"
      type="number"
      step="any"
      name="latitude"
      placeholder="Enter latitude"
      required
    />
  </div>
  <div class="field">
    <label class="label">Longitude</label>
    <input
      class="input"
      type="number"
      step="any"
      name="longitude"
      placeholder="Enter longitude"
      required
    />
  </div>
  <button class="button is-link">Add Station</button>
</form>