{{> welcome-menu active="signup"}}

<section class="section">
  <h1 class="title">{{title}}</h1>

  <div class="columns is-vcentered">
    <div class="column is-half">
    <div class="box">
      <form action="/register" method="POST">
        <label class="label">Name</label>
        <div class="field is-horizontal">
          <div class="field-body">
            <div class="field">
              <input class="input" type="text" placeholder="Enter first name" name="firstName">
            </div>
            <div class="field">
              <input class="input yellow" type="text" placeholder="Enter last name" name="lastName">
            </div>
          </div>
        </div>
        <div class="field">
          <label class="label">Email</label>
          <input class="input has-background-warning-light" type="text" placeholder="Enter email" name="email">
        </div>
        <div class="field">
          <label class="label">Password</label>
          <input class="input has-background-warning-light" type="password" placeholder="Enter Password" name="password">
        </div>
        <div class="field is-grouped">
          <button class="button is-link">Submit</button>
        </div>
      </form>
      </div>
</div>
    <div class="column is-half">
      {{> weather-icons-list}}
    </div>
    </div>
  
</section>
